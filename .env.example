# Copy this file to .env and fill in values locally.
USER_EMAIL=
EMAIL_APP_PASSWORD=
POSTGRES_CONNECTION_STRING=postgresql://jobify:change-me@db:5432/jobify
TANITJOBS_BASE_URL=https://www.tanitjobs.com
TANITJOBS_SEARCH_URL=https://www.tanitjobs.com/jobs/
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_JOBS=10
SCRAPER_JOBS_PER_KEYWORD=5
SCRAPER_VERIFY_TLS=false
# If your network performs HTTPS inspection, point this to a trusted CA bundle
# path inside the container (for example: /workspace/certs/corporate-root-ca.crt).
SCRAPER_CA_BUNDLE_PATH=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
CV_DATA_DIR=/app/cv_data
RENDERCV_SERVICE=rendercv_service
MASTER_CV_DIR=/workspace/master_cv
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180
CV_CHUNK_SIZE=1000
CV_CHUNK_OVERLAP=200
CV_CHUNK_SIZE=900
CV_CHUNK_OVERLAP=150
RETRIEVAL_LIMIT=6
